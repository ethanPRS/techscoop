<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- Sticky top section: Search bar + filter bar + button  -->
    <!-- ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutSearchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Search input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search news…"
            app:startIconDrawable="@drawable/ic_search"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#3F51B5"
            app:hintTextColor="#888888">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Horizontal Filter Chip Bar ── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Source filter chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterSource"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Source"
                    android:textSize="13sp"
                    android:checkable="false"
                    app:chipIcon="@android:drawable/ic_menu_sort_by_size"
                    app:chipIconTint="#3F51B5"
                    app:closeIconVisible="false"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipStrokeColor="#DDDDDD"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:layout_marginEnd="6dp" />

                <!-- Sort filter chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterSort"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Most Recent"
                    android:textSize="13sp"
                    android:checkable="false"
                    app:chipIcon="@android:drawable/ic_menu_sort_alphabetically"
                    app:chipIconTint="#3F51B5"
                    app:closeIconVisible="false"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipStrokeColor="#DDDDDD"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:layout_marginEnd="6dp" />

                <!-- Time period filter chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterPeriod"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Any Time"
                    android:textSize="13sp"
                    android:checkable="false"
                    app:chipIcon="@android:drawable/ic_menu_recent_history"
                    app:chipIconTint="#3F51B5"
                    app:closeIconVisible="false"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipStrokeColor="#DDDDDD"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:layout_marginEnd="6dp" />

                <!-- Language filter chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterLanguage"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="English"
                    android:textSize="13sp"
                    android:checkable="false"
                    app:chipIcon="@android:drawable/ic_menu_mapmode"
                    app:chipIconTint="#3F51B5"
                    app:closeIconVisible="false"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipStrokeColor="#DDDDDD"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:layout_marginEnd="6dp" />

                <!-- Clear all filters -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipClearFilters"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textSize="13sp"
                    android:textColor="#FF5252"
                    android:checkable="false"
                    app:closeIconVisible="false"
                    app:chipBackgroundColor="#FFF5F5"
                    app:chipStrokeColor="#FFCDD2"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="20dp"
                    android:visibility="gone" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Search button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Search"
            android:textSize="15sp"
            android:backgroundTint="#3F51B5"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- Status + Results (scrollable below header)            -->
    <!-- ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Status bar: result count / message -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvSearchStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#555555"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/progressSearch"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
